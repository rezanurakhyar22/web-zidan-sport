Options -Indexes
DirectorySlash Off
DirectoryIndex index.html

<IfModule LiteSpeed>
    CacheLookup off
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/plain "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType font/woff2 "access plus 30 days"
    ExpiresByType font/woff "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm|txt|json)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0, s-maxage=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header unset ETag
    </FilesMatch>

    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>

    Header set X-LiteSpeed-Cache-Control "no-cache, no-store"
</IfModule>

RewriteEngine On
RewriteBase /

# Jangan terapkan aturan rewrite public_html ke subdomain (api-v2, api, v1, dll.)
RewriteCond %{HTTP_HOST} !^(www\.)?zidansport\.org$ [NC]
RewriteRule ^ - [L]

# Allow SSL verification, Next.js static assets, API, and uploaded files
RewriteRule ^\.well-known/ - [L]
RewriteRule ^_next/(.*)$ - [L]
RewriteRule ^api/(.*)$ - [L]
RewriteRule ^public/files/(.*)$ - [L]

# Tangani folder Next.js tanpa index.html (baik /auth/login maupun /auth/login/)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteCond %{REQUEST_URI} ^/(.+?)/?$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^ /%1.html [L]

# Hapus trailing slash jika bukan folder nyata
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteRule ^ /%1 [R=301,L]

# Izinkan file atau folder yang memang memiliki index.html
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^ - [L]

# Routing .html otomatis
RewriteCond %{REQUEST_URI} ^/(.+?)/?$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^ /%1.html [L]

# Fallback
RewriteRule ^.*$ /index.html [L]
